---
import { profile } from "../../data/profile";
import LanguageToggle from "./LanguageToggle";
import MobileMenu from "./MobileMenu";
import ThemeToggle from "./ThemeToggle";
import LocalizedText from "../common/LocalizedText.astro";

const { brand } = profile;
const links = [
  { href: "#inicio", es: "Inicio", en: "Home" },
  { href: "#proyectos", es: "Proyectos", en: "Projects" },
  {
    href: "#experiencia",
    es: "Experiencia & Certificaciones",
    en: "Experience & Certifications",
  },
  { href: "#skills", es: "Skills", en: "Skills" },
  { href: "#sobre-mi", es: "Sobre mí", en: "About me" },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-5 lg:px-8">
  <div
    class="theme-transition mx-auto flex h-16 max-w-7xl items-center justify-between rounded-2xl border border-border bg-base/80 px-3 shadow-sm backdrop-blur-md sm:px-4 lg:px-5"
  >
    <a
      href="#inicio"
      class="group flex min-w-0 items-center gap-3"
      aria-label={`${brand} — Inicio`}
    >
      <span
        class="theme-transition grid size-10 shrink-0 place-items-center rounded-full border border-accent/30 bg-accent/10 type-caption font-mono font-black text-accent"
        >AR</span
      >
      <span
        class="type-caption hidden truncate font-mono font-bold tracking-tight text-text-primary sm:block"
        >{brand}</span
      >
    </a>

    <div class="hidden items-center gap-2 lg:flex">
      <nav class="mr-2 flex items-center" aria-label="Principal">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="type-body-sm rounded-lg px-3 py-2 font-medium text-text-muted transition-colors duration-200 hover:text-accent"
            >
              <LocalizedText es={link.es} en={link.en} />
            </a>
          ))
        }
      </nav>
      <LanguageToggle client:load />
      <ThemeToggle client:load />
    </div>

    <MobileMenu client:load />
  </div>
</header>
